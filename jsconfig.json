{
    "compilerOptions": {
        "module": "commonjs",
        "target": "ES2022",
        "lib": ["ES2022"],
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "strict": false,
        "skipLibCheck": true,
        "maxNodeModuleJsDepth": 0,
        "types": ["node", "vscode"]
    },
    "include": ["extension.js", "lib/**/*.js"]
}
