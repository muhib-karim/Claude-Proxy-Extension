{
    "name": "claude-proxy-status",
    "displayName": "Antigravity Proxy Status",
    "description": "Model switching with account & quota display - proxy auto-starts only when enabled",
    "version": "4.3.0",
    "publisher": "ai-dev-2024",
    "repository": {
        "type": "git",
        "url": "https://github.com/muhib-karim/Claude-Proxy-Extension"
    },
    "icon": "icon.png",
    "license": "MIT",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "antigravity",
        "claude",
        "proxy",
        "google ai",
        "gemini",
        "model-switcher"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./extension.js",
    "scripts": {
        "lint": "eslint .",
        "test": "node --test test/*.test.js",
        "check": "npm run lint && npm test"
    },
    "contributes": {
        "commands": [
            {
                "command": "antigravity.openDashboard",
                "title": "Antigravity: Open Dashboard"
            },
            {
                "command": "antigravity.switchModel",
                "title": "Antigravity: Switch Model"
            },
            {
                "command": "antigravity.showQuotaInfo",
                "title": "Antigravity: Show Quota Info"
            }
        ]
    },
    "homepage": "https://open-vsx.org/extension/ai-dev-2024/claude-proxy-status",
    "bugs": {
        "url": "https://github.com/muhib-karim/Claude-Proxy-Extension/issues"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "eslint": "^9.39.5",
        "globals": "^17.13.0"
    }
}
