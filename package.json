{
    "name": "claude-proxy-status",
    "displayName": "Antigravity Proxy Status",
    "description": "Model switching with account & quota display - proxy auto-starts only when enabled",
    "version": "4.3.0",
    "publisher": "ai-dev-2024",
    "repository": {
        "type": "git",
        "url": "https://github.com/muhib-karim/Claude-Proxy-Extension"
    },
    "icon": "icon.png",
    "license": "MIT",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "antigravity",
        "claude",
        "proxy",
        "google ai",
        "gemini",
        "model-switcher"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./extension.js",
    "scripts": {
        "lint": "eslint .",
        "test": "node --test test/quota.test.js test/pm2.test.js test/extension.test.js test/extension.behavior.test.js test/package-files.test.js",
        "check": "npm run lint && npm test",
        "verify:package": "npx --yes @vscode/vsce@4.1.0 ls | node scripts/check-vsix-files.js",
        "package": "npx --yes @vscode/vsce@4.1.0 package"
    },
    "contributes": {
        "commands": [
            {
                "command": "antigravity.openDashboard",
                "title": "Antigravity: Open Dashboard"
            },
            {
                "command": "antigravity.switchModel",
                "title": "Antigravity: Switch Model"
            },
            {
                "command": "antigravity.showQuotaInfo",
                "title": "Antigravity: Show Quota Info"
            }
        ],
        "configuration": {
            "title": "Antigravity Proxy Status",
            "properties": {
                "antigravity.proxyScriptPath": {
                    "type": "string",
                    "default": "",
                    "scope": "machine",
                    "markdownDescription": "Absolute path to the proxy's entry script (for example `/home/me/proxy/src/index.js`). Only used as a fallback: when `pm2 restart antigravity-proxy` fails because the proxy is not registered with PM2 yet, the extension runs `pm2 start <path> --name antigravity-proxy`. Leave empty to only use `pm2 restart`."
                }
            }
        }
    },
    "homepage": "https://open-vsx.org/extension/ai-dev-2024/claude-proxy-status",
    "bugs": {
        "url": "https://github.com/muhib-karim/Claude-Proxy-Extension/issues"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "eslint": "^9.39.5",
        "globals": "^17.13.0"
    }
}
